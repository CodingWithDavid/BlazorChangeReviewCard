@inherits LayoutComponentBase

<header class="site-header">
    <div class="header-inner">
        <a class="brand" href="" aria-label="Change Review home">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M7 12.5 10.2 16 17.5 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
            <span>ChangeReview<span class="brand-period">.</span></span>
        </a>

        <nav class="main-nav" aria-label="Main navigation">
            <a href="#review-queue">Review queue</a>
            <a href="#how-it-works">How it works</a>
        </nav>

        <a class="header-cta" href="#review-queue">
            Start reviewing
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </a>
    </div>
</header>

<main>
    @Body
</main>

<footer class="site-footer">
    <div class="footer-inner">
        <a class="brand footer-brand" href="">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M7 12.5 10.2 16 17.5 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
            <span>ChangeReview<span class="brand-period">.</span></span>
        </a>
        <p>Thoughtful reviews. Confident changes.</p>
        <a href="#review-queue">Back to review queue <span aria-hidden="true">↑</span></a>
    </div>
</footer>
